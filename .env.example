# I Need Air local configuration
# Copy this file to .env, then add only the values you plan to use.
# Never commit .env or share it in screenshots.

# The default is Ollama, which runs locally and needs no API key.
AI_PROVIDER=ollama
OLLAMA_MODEL=llama3.2

# Optional: use Gemini instead of Ollama.
# AI_PROVIDER=gemini
# GEMINI_API_KEY=paste-your-key-here
# GEMINI_MODEL=gemini-2.5-flash

# Reserved for the future OpenRouteService route integration.
# OPENROUTESERVICE_API_KEY=paste-your-key-here

# Optional: use a custom folder for SQLite data.
# INEEDAIR_DATA_DIR=C:\path\to\i-need-air-data
